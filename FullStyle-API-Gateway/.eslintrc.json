{
  "root": true,
  "env": { "node": true, "es2021": true },
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended"],
  "overrides": [
    {
      "files": ["*.ts"],
      "rules": {
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": "error"
      }
    }
  ],
  "ignorePatterns": ["dist/", "node_modules/"]
}
