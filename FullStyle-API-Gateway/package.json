{
  "name": "fullstyle-graphql-gateway",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-schemas.cjs",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.cjs",
    "lint": "eslint src scripts tests --ext .ts,.cjs",
    "format:check": "prettier --check \"src/**/*.{ts,graphql}\" \"scripts/*.cjs\" \"tests/*.cjs\""
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@graphql-tools/merge": "^10.0.8",
    "axios": "^1.21.0",
    "graphql": "^16.15.0",
    "graphql-tag": "^2.12.7"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.1",
    "prettier": "3.5.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "11.0.2"
    }
  }
}
