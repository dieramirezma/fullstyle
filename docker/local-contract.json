      "GCLOUD_PROJECT": "demo-fullstyle"
    },
    "db-init": {
      "LOCAL_RUNTIME": "true",
      "HOST": "0.0.0.0",
      "PORT": "5000",
      "ENV": "local",
      "DATABASE_URL": "postgresql://synthetic:local-synthetic-only@postgres/fullstyle_synthetic",
      "SECRET_KEY": "synthetic-phase3-flask-secret",
      "JWT_SECRET_KEY": "synthetic-phase3-jwt-signing-key-32bytes-minimum",
